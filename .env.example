# Dirección de la API. La API de desarrollo corre en el puerto 3000.
# Teléfono físico (misma Wi-Fi): IP LAN de la computadora, por ejemplo http://192.168.1.10:3000
# Android Emulator: http://10.0.2.2:3000
# Web e iOS Simulator: http://localhost:3000
# Si usás un teléfono, la IP de abajo tiene que ser la de tu computadora, no localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# La clave de maps va aca
GOOGLE_MAPS_ANDROID_API_KEY=
