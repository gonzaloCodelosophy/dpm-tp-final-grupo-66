{
  "expo": {
    "name": "Mi Ciudad Colón",
    "slug": "turismo-colon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/colon-icon.png",
    "scheme": "turismocolon",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDF7EC",
        "foregroundImage": "./assets/images/colon-adaptive-foreground.png",
        "monochromeImage": "./assets/images/colon-adaptive-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.grupo66.turismocolon",
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/colon-favicon.png"
    },
    "plugins": [
      "./plugins/with-backend-http",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-colon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#FDF7EC",
          "dark": {
            "backgroundColor": "#FDF7EC"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-bell.png",
          "color": "#ffffff",
          "defaultChannel": "default",
          "sounds": [],
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos tu ubicación para mostrar los lugares cercanos y sus distancias.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      [
        "expo-navigation-bar",
        {
          "barStyle": "dark"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Usamos tus fotos para que puedas elegir una imagen de perfil.",
          "cameraPermission": "Usamos la cámara para sacar fotos de tus visitas y escanear el QR de un lugar.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Usamos la cámara para sacar fotos de tus visitas y escanear el QR de un lugar.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "androidStatusBar": {
      "barStyle": "dark-content"
    },
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "enforceContrast": false
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "barStyle": "dark"
      },
      "eas": {
        "projectId": "3d3aa3ba-e6f2-4eb3-b363-257233dafba2"
      }
    },
    "owner": "nemesysrgs"
  }
}
